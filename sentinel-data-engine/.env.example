# =============================================================================
# Sentinel Data Engine – Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# --- AWS / S3 ----------------------------------------------------------------
S3_BUCKET_NAME=your_bucket_name_here
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# --- Local data paths (used in LOCAL run mode) --------------------------------
LOCAL_RAW_DATA_DIR=./data/raw
LOCAL_BRONZE_DATA_DIR=./data/bronze
LOCAL_SILVER_DATA_DIR=./data/silver

# --- Databricks (used in DATABRICKS run mode) ---------------------------------
DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
DATABRICKS_TOKEN=your_databricks_token_here
DATABRICKS_CATALOG=sentinel
DATABRICKS_SCHEMA_BRONZE=bronze
DATABRICKS_SCHEMA_SILVER=silver
