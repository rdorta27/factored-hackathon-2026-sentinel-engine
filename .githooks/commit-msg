#!/usr/bin/env bash
# Validates the commit message: Conventional Commits header with no
# scope/!, mandatory body in 2 blocks (why, changes labeled "Changes:"
# + bullets), no versions, no Co-Authored-By trailers, no emojis (✓ and
# ✗ allowed). Lets merges through unvalidated: MERGE_HEAD is the
# reliable criterion, since $2 is empty in a plain `git merge`.
# Git runs this hook before cleanup, so the file still has the comment
# template and, with commit.verbose, the diff under the scissors line.
# Those are stripped here the same way git will strip them before
# storing the commit.
# Bash 3.2 (macOS /bin/bash) has no mapfile, and before 4.4 set -u
# rejects "${array[@]}" when the array is empty. Lines are read with
# a loop, and an empty list is never expanded. A trailing CR is
# removed so a CRLF message still matches. Activate once per clone:
# git config core.hooksPath .githooks
set -euo pipefail

if [[ $# -lt 1 ]]; then
	echo "commit-msg: missing the message file (usage: commit-msg <file> [source])" >&2
	exit 1
fi

readonly MSG_FILE="$1"
readonly TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
readonly HEADER_RE="^(${TYPES}): (.+)$"
readonly CHANGES_LABEL="Changes:"
readonly BULLET_RE="^- .+"
readonly VERSION_RE="\bv[0-9]+\.[0-9]+\.[0-9]+\b"
readonly BARE_VERSION_RE="\b[0-9]+\.[0-9]+\.[0-9]+\b"
readonly COAUTHOR_RE="^[Cc]o-[Aa]uthored-[Bb]y:"
# Emoji ranges, explicitly excluding ✓ (U+2713) and ✗ (U+2717).
readonly EMOJI_RE='[\x{2600}-\x{26FF}\x{2700}-\x{2712}\x{2714}-\x{2716}\x{2718}-\x{27BF}\x{2B00}-\x{2BFF}\x{1F000}-\x{1FFFF}]'
readonly UPPERCASE_SUMMARY_RE="^[A-Z]"
# git's cut line (wt-status). Everything from this line down is the
# verbose diff, not part of the message.
readonly SCISSORS_MARK="------------------------ >8 ------------------------"

_fail() {
	local reason="$1"
	{
		echo "commit-msg: ${reason}"
		echo "Expected format: <type>: <summary>"
		echo "  type: ${TYPES//|/, }"
		echo "  summary: lowercase, no trailing period"
		echo "  body: 2 blocks separated by a blank line —"
		echo "    1) why paragraph (prose, no '- ')"
		echo "    2) 'Changes:' followed by one or more '- ' bullets"
		echo "  no versions, no Co-Authored-By, no emojis"
	} >&2
	exit 1
}

# First version in `text` (v-prefixed or bare X.Y.Z): prints it and
# returns 0; returns 1 if none.
_forbidden_version() {
	local text="$1"
	if [[ "${text}" =~ ${VERSION_RE} || "${text}" =~ ${BARE_VERSION_RE} ]]; then
		printf '%s' "${BASH_REMATCH[0]}"
		return 0
	fi
	return 1
}

# Rejecting emojis needs grep -P; when missing, the check is skipped.
_pcre_supported() {
	printf 'a' | grep -qP 'a' 2>/dev/null
}

# Comment prefix git will strip. core.commentString wins over
# core.commentChar. "auto" depends on the message; "#" matches git's
# fallback and this repo's config.
_comment_prefix() {
	local prefix=""
	if prefix="$(git config --get core.commentString 2>/dev/null)" && [[ -n "${prefix}" ]]; then
		printf '%s' "${prefix}"
		return 0
	fi
	if prefix="$(git config --get core.commentChar 2>/dev/null)" \
		&& [[ -n "${prefix}" && "${prefix}" != "auto" ]]; then
		printf '%s' "${prefix}"
		return 0
	fi
	printf '%s' "#"
}

# Reads MSG_FILE into the global RAW_LINES. A final line without a
# newline is kept. A trailing CR is removed so CRLF matches LF.
_read_lines() {
	RAW_LINES=()
	local line
	while IFS= read -r line || [[ -n "${line}" ]]; do
		RAW_LINES+=("${line%$'\r'}")
	done < "${MSG_FILE}"
}

# Drops the verbose diff (from the scissors line down) and lines git
# treats as comments. Arguments after the prefix are the lines. "$@"
# is used directly: copying it into an array is wrong on Bash 3.2 when
# there are no arguments, and expanding an empty array trips set -u
# before 4.4. Result in the global CLEAN_LINES. An empty result is
# success: the caller reports the missing body.
_clean_lines() {
	local prefix="$1"
	shift
	CLEAN_LINES=()
	local line
	for line in "$@"; do
		if [[ "${line}" == *"${SCISSORS_MARK}"* ]]; then
			break
		fi
		if [[ -n "${prefix}" && "${line}" == "${prefix}"* ]]; then
			continue
		fi
		CLEAN_LINES+=("${line}")
	done
}

# Groups lines[from:] into blocks separated by one or more blank
# lines, ignoring trailing blank lines. Result in the global BLOCKS.
# Zero blocks is a successful split, not an error: the last command
# must not fail under set -e, or an empty body aborts with no message.
_split_blocks() {
	local from="$1"
	shift
	local -a src=()
	local line
	for line in "$@"; do
		src+=("${line}")
	done

	local end="${#src[@]}"
	while ((end > from)) && [[ -z "${src[end - 1]}" ]]; do
		end=$((end - 1))
	done

	BLOCKS=()
	local current=""
	local i
	for ((i = from; i < end; i++)); do
		line="${src[i]}"
		if [[ -z "${line}" ]]; then
			if [[ -n "${current}" ]]; then
				BLOCKS+=("${current}")
				current=""
			fi
			continue
		fi
		if [[ -z "${current}" ]]; then
			current="${line}"
		else
			current="${current}"$'\n'"${line}"
		fi
	done
	if [[ -n "${current}" ]]; then
		BLOCKS+=("${current}")
	fi
}

_block_has_bullet() {
	local block="$1"
	local line
	while IFS= read -r line; do
		[[ "${line}" =~ ${BULLET_RE} ]] && return 0
	done <<< "${block}"
	return 1
}

# Splits a block into its lines, into the global BLOCK_LINES.
_block_lines() {
	local block="$1"
	BLOCK_LINES=()
	local line
	while IFS= read -r line; do
		BLOCK_LINES+=("${line}")
	done <<< "${block}"
}

main() {
	git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0

	_read_lines
	if [[ ${#RAW_LINES[@]} -gt 0 ]]; then
		_clean_lines "$(_comment_prefix)" "${RAW_LINES[@]}"
	else
		_clean_lines "$(_comment_prefix)"
	fi
	local -a lines=()
	if [[ ${#CLEAN_LINES[@]} -gt 0 ]]; then
		lines=("${CLEAN_LINES[@]}")
	fi

	local header="${lines[0]:-}"
	[[ -n "${header}" ]] || _fail "the message is empty"
	[[ "${header}" =~ ${HEADER_RE} ]] || _fail "invalid header: \"${header}\""

	local summary="${BASH_REMATCH[2]}"
	[[ "${summary}" != *. ]] || _fail "the summary must not end in a period"
	[[ ! "${summary}" =~ ${UPPERCASE_SUMMARY_RE} ]] \
		|| _fail "the summary must start lowercase: \"${summary}\""

	[[ "${#lines[@]}" -ge 2 && -z "${lines[1]}" ]] \
		|| _fail "missing body: a blank line and 2 blocks (why, changes) come after the header"

	local -a BLOCKS
	_split_blocks 2 "${lines[@]}"

	[[ "${#BLOCKS[@]}" -eq 2 ]] \
		|| _fail "expected 2 blocks in the body (why, changes), found ${#BLOCKS[@]}"

	_block_has_bullet "${BLOCKS[0]}" && _fail "the why block must not use '- ' bullets, it's prose"

	local -a BLOCK_LINES
	_block_lines "${BLOCKS[1]}"
	[[ "${BLOCK_LINES[0]:-}" == "${CHANGES_LABEL}" ]] \
		|| _fail "the changes block must start with the literal line '${CHANGES_LABEL}'"
	[[ "${#BLOCK_LINES[@]}" -ge 2 ]] \
		|| _fail "the changes block needs at least one '- ' bullet after '${CHANGES_LABEL}'"

	local i
	for ((i = 1; i < ${#BLOCK_LINES[@]}; i++)); do
		[[ "${BLOCK_LINES[i]}" =~ ${BULLET_RE} ]] \
			|| _fail "every line after '${CHANGES_LABEL}' must start with '- ': \"${BLOCK_LINES[i]}\""
	done

	local full_message
	full_message="$(printf '%s\n' "${lines[@]}")"

	local forbidden
	if forbidden="$(_forbidden_version "${full_message}")"; then
		_fail "versions live in tags, not in messages — '${forbidden}' looks like a version; name the dependency without its number"
	fi

	if grep -qE "${COAUTHOR_RE}" <<< "${full_message}"; then
		_fail "the message can't include Co-Authored-By trailers"
	fi

	if _pcre_supported && grep -qP "${EMOJI_RE}" <<< "${full_message}"; then
		_fail "the message can't include emojis"
	fi
}

main
