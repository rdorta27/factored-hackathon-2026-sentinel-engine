# Copy to .env and fill in real values. Never commit .env.
# This file documents variable names only; it holds no secrets.

# Salt for anonymizing session ids in structured turn logs
# (session_ref = sha256(salt + session_id), truncated to 16 hex chars).
# Generate one per deployment, e.g. `python3 -c "import secrets; print(secrets.token_hex(16))"`.
# The salt itself is never logged. If unset, the service generates a dev salt
# at sentinel-ai-core/var/.session_salt (gitignored) on first run and reuses it, so restarts
# correlate on the same machine. Set a real per-deployment value anyway.
SENTINEL_SESSION_SALT=

# Notion of "today" for the dispute window, the transaction as-of mark,
# and the date shown to the customer. Defaults to 2026-06-17 when unset.
SENTINEL_REFERENCE_DATE=2026-06-17

# Prompted LLM router (decision 10 stays open; unset means keyword baseline).
# Base URL of an OpenAI-compatible chat-completions endpoint. Empty disables it.
SENTINEL_LLM_BASE_URL=
# API key for the endpoint above. Never commit a value; read from .env only.
SENTINEL_LLM_API_KEY=
# Model per route: cheap frequent turns, strong ambiguous or pt-BR turns, default fallback.
SENTINEL_LLM_CHEAP_MODEL=
SENTINEL_LLM_STRONG_MODEL=
SENTINEL_LLM_DEFAULT_MODEL=
# Prompt version recorded on every understand record for experiment tracking.
SENTINEL_LLM_PROMPT_VERSION=v1
# HTTP timeout in seconds and bounded retries before ModelUnavailable.
SENTINEL_LLM_TIMEOUT_S=10
SENTINEL_LLM_MAX_RETRIES=2

# Gold source behind the GoldTransactions seam: auto (DuckDB view when readable,
# mock otherwise), mock, or duckdb (still falls back to the mock if unreadable).
# GET /api/v1/health reports the active source.
SENTINEL_GOLD_SOURCE=auto
# Directory holding the Delta view v_service_dispute_eligible_transactions.
SENTINEL_GOLD_DIR=data/gold
# Optional users file for real Gold (logins mapped to real customer ids).
# Keep it under the gitignored data/ folder; empty uses the test fixture.
SENTINEL_USERS_PATH=
# Where sessions, conversation state and cases live: sqlite (default) or memory.
SENTINEL_STATE_BACKEND=sqlite
# SQLite file; empty uses sentinel-ai-core/var/sentinel.db (gitignored).
SENTINEL_DB_PATH=
# Demo roles: 1 loads the documented false advisor user (ADV-0001). A password is
# always required; without the flag only customers can log in.
SENTINEL_DEMO_AUTH=0
