# Copy to .env and fill in real values. Never commit .env.
# This file documents variable names only; it holds no secrets.

# Salt for anonymizing session ids in structured turn logs
# (session_ref = sha256(salt + session_id), truncated to 16 hex chars).
# Generate one per deployment, e.g. `python3 -c "import secrets; print(secrets.token_hex(16))"`.
# The salt itself is never logged. If unset, the service generates a dev salt
# at sentinel-ai-core/var/.session_salt (gitignored) on first run and reuses it, so restarts
# correlate on the same machine. Set a real per-deployment value anyway.
SENTINEL_SESSION_SALT=

# Notion of "today" for the dispute window, the transaction as-of mark,
# and the date shown to the customer. Defaults to 2026-06-17 when unset.
SENTINEL_REFERENCE_DATE=2026-06-17

# The session cookie carries the Secure flag by default (production is HTTPS).
# Set false only for plain-HTTP local dev; tests default it to false in
# tests/conftest.py. Production deployments never unset it.
# SENTINEL_SECURE_COOKIES=false

# Prompted LLM router. With the base URL and the API key both set, the app serves
# router_v2 (app/ai/serving.py); a turn whose model call fails is answered by the
# keyword baseline and the turn log marks it (route "fallback"). Either one empty
# serves the keyword baseline. GET /api/v1/health reports the model and prompt version.
# Base URL of an OpenAI-compatible chat-completions endpoint. Fireworks:
# https://api.fireworks.ai/inference/v1
SENTINEL_LLM_BASE_URL=
# API key for the endpoint above. Never commit a value; read from .env only.
# On Azure it goes in as a Container App secret (deploy/azure/deploy.sh).
SENTINEL_LLM_API_KEY=
# Model per route. router_v2 as measured in eval-v7 (decisions 016 and 018) uses one
# model on all three: accounts/fireworks/models/glm-5p3-flash
SENTINEL_LLM_CHEAP_MODEL=
SENTINEL_LLM_STRONG_MODEL=
SENTINEL_LLM_DEFAULT_MODEL=
# Prompt version recorded on every understand record. v2 adds the development examples
# of eval/examples_v2.json (a copy lives in app/ai/examples_v2.json); startup fails if
# they cannot be loaded. router_v2 is v2.
SENTINEL_LLM_PROMPT_VERSION=v2
# Route rule (decision 016 amendment, D3): heuristic, keyword_miss or strong. eval-v7 used heuristic.
SENTINEL_LLM_ROUTE_RULE=heuristic
# Confidence cut-offs (018 amendment). Off by default: the app serves v2 without
# them. Set 1 to load the calibrated cut-offs from app/ai/router_config.json, so
# a label below t_act becomes missing and the loop asks first. A person request
# is never downgraded. Serve it only after the eval-v8 measurement passes.
SENTINEL_LLM_CUTOFFS=
# Reasoning effort sent to the model and the output cap. Empty uses the eval-v7 values
# (low, 400); they are part of what was measured.
SENTINEL_LLM_REASONING_EFFORT=
SENTINEL_LLM_MAX_TOKENS=
# HTTP timeout in seconds and retries per call. Empty uses the served defaults (6 and 1),
# so a failing model costs at most about 12 s before the baseline answers the turn.
# eval-v7 recorded with 10 and 2; these two change latency, not the replies.
SENTINEL_LLM_TIMEOUT_S=
SENTINEL_LLM_MAX_RETRIES=

# Gold source behind the GoldTransactions seam: auto (DuckDB view when readable,
# mock otherwise), mock, or duckdb (still falls back to the mock if unreadable).
# GET /api/v1/health reports the active source.
SENTINEL_GOLD_SOURCE=auto
# Directory holding the Delta view v_service_dispute_eligible_transactions.
SENTINEL_GOLD_DIR=data/gold
# DuckDB Gold file. Empty uses sentinel-data-engine/data/gold_bank.duckdb, resolved
# from the repository, not from the folder the process was started from. A relative
# value is also resolved from the repository. mock never opens a file.
SENTINEL_GOLD_DUCKDB=
# Optional users file for real Gold (logins mapped to real customer ids).
# Keep it under the gitignored data/ folder; empty uses the test fixture.
SENTINEL_USERS_PATH=
# Where sessions, conversation state and cases live: sqlite (default) or memory.
SENTINEL_STATE_BACKEND=sqlite
# SQLite file; empty uses sentinel-ai-core/var/sentinel.db (gitignored).
SENTINEL_DB_PATH=
# Call-center DuckDB file for the ROI aggregates (scripts/roi_aggregates.py);
# empty uses sentinel-data-engine/data/gold_bank.duckdb (gitignored).
SENTINEL_CALLCENTER_DB=
# Demo roles: 1 loads the documented false advisor user (ADV-0001). A password is
# always required; without the flag only customers can log in.
SENTINEL_DEMO_AUTH=0
